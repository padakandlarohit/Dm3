# WEKA Experiment 4.1
# Demonstrate Clustering and Classification
# Algorithms: K-Means, EM, DBSCAN, J48, RandomForest, ZeroR

from sklearn.datasets import load_iris
from sklearn.cluster import KMeans, DBSCAN
from sklearn.mixture import GaussianMixture
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import cross_val_score
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.dummy import DummyClassifier
from sklearn.metrics import adjusted_rand_score
import matplotlib.pyplot as plt

# Load Iris dataset
iris = load_iris()
X = iris.data
y = iris.target

# Standardize numeric features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Part A: K-Means clustering for k = 2, 3, 4, 5
print("K-MEANS CLUSTERING")

sse_values = []

for k in [2, 3, 4, 5]:
    model = KMeans(
        n_clusters=k,
        random_state=10,
        n_init=10
    )
    labels = model.fit_predict(X_scaled)
    sse = model.inertia_
    sse_values.append(sse)

    print(f"\nk = {k}")
    print("SSE:", round(sse, 2))
    print("Cluster sizes:", model.cluster_centers_.shape[0])
    print("Centroids:\n", model.cluster_centers_)

# Elbow plot
plt.figure()
plt.plot([2, 3, 4, 5], sse_values, marker="o")
plt.xlabel("Number of clusters (k)")
plt.ylabel("SSE")
plt.title("K-Means Elbow Method")
plt.show()

# K-Means visualization with k=3
kmeans = KMeans(n_clusters=3, random_state=10, n_init=10)
kmeans_labels = kmeans.fit_predict(X_scaled)

plt.figure()
plt.scatter(
    X[:, 2], X[:, 3],
    c=kmeans_labels,
    cmap="viridis"
)
plt.xlabel("Petal Length")
plt.ylabel("Petal Width")
plt.title("Iris K-Means Clusters (k=3)")
plt.show()

print("\nAdjusted Rand Index:",
      round(adjusted_rand_score(y, kmeans_labels), 3))

# Part A: EM clustering
print("\nEM CLUSTERING")

em = GaussianMixture(
    n_components=3,
    random_state=10
)
em_labels = em.fit_predict(X_scaled)

print("Cluster sizes:",
      [sum(em_labels == i) for i in range(3)])
print("Adjusted Rand Index:",
      round(adjusted_rand_score(y, em_labels), 3))

# Part A: DBSCAN clustering
print("\nDBSCAN CLUSTERING")

dbscan = DBSCAN(eps=0.8, min_samples=5)
dbscan_labels = dbscan.fit_predict(X_scaled)

print("Cluster labels:", set(dbscan_labels))
print("Noise points:", sum(dbscan_labels == -1))
print("Adjusted Rand Index:",
      round(adjusted_rand_score(y, dbscan_labels), 3))

plt.figure()
plt.scatter(
    X[:, 2], X[:, 3],
    c=dbscan_labels,
    cmap="viridis"
)
plt.xlabel("Petal Length")
plt.ylabel("Petal Width")
plt.title("Iris DBSCAN Clusters")
plt.show()

# Part B: Classification using 10-fold cross-validation
print("\nCLASSIFICATION RESULTS")

models = {
    "J48 Equivalent (Decision Tree)": DecisionTreeClassifier(
        random_state=10
    ),
    "Random Forest": RandomForestClassifier(
        n_estimators=100,
        random_state=10
    ),
    "ZeroR Baseline": DummyClassifier(
        strategy="most_frequent"
    )
}

for name, model in models.items():
    scores = cross_val_score(
        model, X, y, cv=10, scoring="accuracy"
    )
    print(f"\n{name}")
    print("Fold accuracies:", scores.round(3))
    print("Mean accuracy:", round(scores.mean() * 100, 2), "%")

print("\nRESULT")
print("Clustering, elbow analysis, EM, DBSCAN,")
print("10-fold classification, and ZeroR baseline completed.")
